{
  "description": "Hooks for Scalekit agentkit plugin",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @scalekit-inc/cli extension status claude --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/beacon.sh agentkit stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
